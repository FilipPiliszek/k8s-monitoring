{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "tags": ["stress-test"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "title": "Stress Test - Zasoby (CPU/RAM) z limitami",
  "uid": "stress-test-resources",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU – zużycie vs limit (0.2 rdzenia)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Limit CPU (0.2 rdzenia)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{pod=~\"test-app-stress-test.*\"}[1m]))",
          "legendFormat": "Zużycie CPU (rdzenie)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(kube_pod_container_resource_limits{resource=\"cpu\",container=\"stress-test\",pod=~\"test-app-stress-test.*\"})",
          "legendFormat": "Limit CPU (0.2 rdzenia)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RAM – zużycie vs limit (~134 MB)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Limit RAM (~134 MB)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(container_memory_working_set_bytes{pod=~\"test-app-stress-test.*\"})",
          "legendFormat": "Zużycie RAM"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(kube_pod_container_resource_limits{resource=\"memory\",container=\"stress-test\",pod=~\"test-app-stress-test.*\"})",
          "legendFormat": "Limit RAM (~134 MB)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Restarty poda (skok = OOMKilled / crash)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 15, "pointSize": 6, "showPoints": "always" },
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "max(kube_pod_container_status_restarts_total{pod=~\"test-app-stress-test.*\"})",
          "legendFormat": "Restarty"
        }
      ]
    }
  ]
}
